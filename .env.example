# Copy this file to .env and fill in your own credentials. Never share or commit .env.

# Neon PostgreSQL (production)
DB_ENGINE=postgres
NEON_HOST=your-neon-host
NEON_PORT=5432
NEON_DB=your-database-name
NEON_USER=your-database-user
NEON_PASSWORD=replace-with-your-database-password
NEON_SSLMODE=require

# Optional MySQL alternative
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_SSL_DISABLED=false
DB_POOL_SIZE=10

# App security
FLASK_ENV=production
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-generated-password-hash
USER_USERNAME=jobseeker
USER_PASSWORD_HASH=replace-with-a-generated-password-hash

# Apify tokens (optional; group tokens override the generic token)
APIFY_API_TOKEN=
APIFY_API_TOKEN_COLLECTOR1=
APIFY_API_TOKEN_COLLECTOR2=
APIFY_API_TOKEN_COLLECTOR3=

# Set actor IDs/inputs and approval flags only after checking each Actor's schema, pricing, and terms.
APIFY_ACTOR_CUTSHORT=
APIFY_INPUT_CUTSHORT=
APIFY_ACCESS_APPROVED_CUTSHORT=false
